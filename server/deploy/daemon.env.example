# /etc/cawl/daemon.env — environment for cawl-daemon.service and cawl-reap.service
DJANGO_SETTINGS_MODULE=cawlserver.settings

CAWL_SECRET_KEY=change-me-to-a-long-random-string
CAWL_DEBUG=0
CAWL_ALLOWED_HOSTS=cawl.example.com
# Django trusts Traefik's X-Forwarded-Proto and emits secure cookies + HSTS.
# Usually CSRF is same-origin; list only intentional cross-origin browser clients.
#CAWL_CSRF_TRUSTED_ORIGINS=https://console.example.com
#CAWL_HSTS_SECONDS=31536000
#CAWL_HSTS_INCLUDE_SUBDOMAINS=1

# Backends: incus_api | fake | none. Fills the named-backend registry
# ("container" + "vm" for the Incus families). Operator-installed backends can
# be merged in — or run alone with CAWL_RUNTIME=none — via name=dotted.path
# entries naming Runtime subclasses in the daemon's venv; see docs/extending.md.
#CAWL_EXTRA_BACKENDS=firecracker=my_backends.FirecrackerRuntime
# Incus REST API (daemon runs on the Incus host → localhost is fine).
CAWL_RUNTIME=incus_api
CAWL_INCUS_URL=https://127.0.0.1:8443
CAWL_INCUS_CLIENT_CERT=/etc/cawl/incus/client.crt
CAWL_INCUS_CLIENT_KEY=/etc/cawl/incus/client.key
CAWL_INCUS_SERVER_CERT=/etc/cawl/incus/server.crt
CAWL_INCUS_PROJECT=default
CAWL_IMAGE_PREFIX=cawl

# SSH access provider: tailscale | jump | bridge. Unset = inferred from which
# settings below are present (authkey → tailscale, else jump host → jump, else
# bridge). Naming one whose settings are missing is a startup error.
#CAWL_ACCESS=tailscale
# tailscale: instances join the tailnet at boot — as transport only, NOT
# Tailscale SSH (which would authenticate from tailnet identity and know
# nothing about who owns an environment). Ephemeral, reusable, pre-authorized
# authkey. The tailnet policy needs no `ssh` block, just tcp/22 reachability
# to tag:cawl.
CAWL_TAILSCALE_AUTHKEY=tskey-auth-xxxx
CAWL_TAILSCALE_TAGS=tag:cawl
# jump: relay bridge IPs through a jump host developers can already SSH to —
# typically this host. [user@]host[:port]; `cawl ssh` wires up the
# ProxyCommand. Their jump account is theirs; the box still takes only certs.
#CAWL_SSH_JUMP=jump.example.com
# bridge: instances' bridge IPs dialed directly; routing (LAN, your own VPN)
# is on you. No settings — just CAWL_ACCESS=bridge, or nothing at all.

# Outbound workload connectivity. Default is none: enforce deny-egress for the
# workload bridge at the host. "proxy" writes HTTP(S)_PROXY in each VM; it is
# not enforcement by itself — permit only this private listener in the bridge
# ACL/firewall, with no direct NAT route.
#CAWL_EGRESS=proxy
#CAWL_EGRESS_NETWORK=cawl-agent
#CAWL_EGRESS_PROXY_URL=http://10.42.0.1:3128

# SSH certificate authority. Signing a cert IS the SSH authorization decision, so
# this key mints access to every environment: root-only, and never in the repo.
#   ssh-keygen -q -t ed25519 -N "" -C cawl-ca -f /etc/cawl/ssh_ca && chmod 600 …
# Unset = no SSH at all (`cawl exec` still works).
CAWL_SSH_CA_KEY=/etc/cawl/ssh_ca
CAWL_SSH_USER=dev
CAWL_SSH_CERT_TTL=10m

# Database URL (dj-database-url). Omit to fall back to sqlite for a trial.
CAWL_DATABASE_URL=postgres://cawl:change-me@127.0.0.1:5432/cawl

# Ingress + networking. CAWL_INGRESS_DIR must equal Traefik's file-provider dir.
CAWL_INGRESS_DIR=/etc/traefik/dynamic
# Exposures live one label under this domain (any free label; default, the
# env's id). Needs a wildcard DNS record (*.<domain>) pointing at the Traefik
# host, and the wildcard cert in traefik.yml.
CAWL_BASE_DOMAIN=sbx.example.com
# Where magic-link sign-in and SSO live (served by this daemon, routed by
# Traefik). Default: auth.<CAWL_BASE_DOMAIN>, covered by the same wildcard.
# CAWL_AUTH_HOST=auth.sbx.example.com
# How TRAEFIK reaches this daemon — an internal URL. Used for the forward-auth
# subrequest and to proxy the auth host + the reserved /.cawl/ paths.
CAWL_DAEMON_URL=http://127.0.0.1:8080
# CAWL_FORWARD_AUTH_URL=http://127.0.0.1:8080/auth/forward   # default: derived
# Browser sessions per exposed host (seconds); one-time magic links default to 4h.
# CAWL_WEB_SESSION_TTL=43200
# CAWL_MAGIC_TTL=14400
# Outbound email for magic links. Default backend prints to the journal — fine
# to start with, since `cawl expose` also returns the links for handing out.
# CAWL_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# CAWL_EMAIL_FROM=cawl@example.com
# EMAIL_HOST=... EMAIL_PORT=... (standard Django SMTP settings if needed)
CAWL_TAILNET=tailXXXX.ts.net
CAWL_DEFAULT_QUOTA=10

# Human SSO (optional). Enable + fill OIDC_* to allow browser/admin login.
CAWL_OIDC_ENABLED=0
# OIDC_RP_CLIENT_ID=
# OIDC_RP_CLIENT_SECRET=
# OIDC_OP_AUTH=
# OIDC_OP_TOKEN=
# OIDC_OP_USER=
