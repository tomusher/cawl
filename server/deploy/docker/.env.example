# Copy to .env, fill in the values, then run: docker compose up -d --build
POSTGRES_PASSWORD=replace-with-a-long-random-password
CAWL_SECRET_KEY=replace-with-a-long-random-django-secret
CAWL_DEBUG=0
CAWL_ALLOWED_HOSTS=your-cawl-hostname,localhost,127.0.0.1
# List only intentional cross-origin browser clients; same-origin needs no entry.
#CAWL_CSRF_TRUSTED_ORIGINS=https://console.example.com
CAWL_HSTS_SECONDS=31536000
CAWL_HSTS_INCLUDE_SUBDOMAINS=1
CAWL_API_PORT=8000

# A wildcard DNS record (*.sbx.example.com) must point to this host.
CAWL_BASE_DOMAIN=sbx.example.com
TRAEFIK_ACME_EMAIL=ops@example.com
# Traefik/lego DNS challenge provider name; cloudflare is one example.
TRAEFIK_DNS_PROVIDER=cloudflare
# Provider credentials are passed through to Traefik. For Cloudflare:
CF_DNS_API_TOKEN=replace-with-a-cloudflare-dns-api-token

# Incus is normally reachable from the Docker host. Use host.docker.internal on
# Docker Desktop; on Linux use the host gateway address or a routable address.
CAWL_RUNTIME=incus_api
CAWL_INCUS_URL=https://host.docker.internal:8443
CAWL_INCUS_CLIENT_CERT=/run/secrets/incus/client.crt
CAWL_INCUS_CLIENT_KEY=/run/secrets/incus/client.key
CAWL_INCUS_SERVER_CERT=/run/secrets/incus/server.crt
CAWL_INCUS_PROJECT=default
CAWL_IMAGE_PREFIX=cawl

# Required for `cawl ssh`; leave unset only if SSH access is intentionally off.
CAWL_SSH_CA_KEY=/run/secrets/ssh_ca
CAWL_SSH_USER=dev
# Set one access mode appropriate for the Incus network.
# CAWL_ACCESS=jump
# CAWL_SSH_JUMP=cawl.example.com

CAWL_DEFAULT_QUOTA=10
