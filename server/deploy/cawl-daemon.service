[Unit]
Description=cawl control-plane daemon (Django + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=cawl
Group=cawl
WorkingDirectory=/srv/cawl/server
EnvironmentFile=/etc/cawl/daemon.env
ExecStart=/srv/cawl/.venv/bin/gunicorn cawlserver.wsgi:application \
    --bind 127.0.0.1:8000 --workers 3 --timeout 120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
