# Copy to .env, fill in the values, then run: docker compose up -d
POSTGRES_PASSWORD=replace-with-a-long-random-password
CAWL_SECRET_KEY=replace-with-a-long-random-django-secret
CAWL_DEBUG=0
CAWL_ALLOWED_HOSTS=your-cawl-hostname,localhost,127.0.0.1
# List only intentional cross-origin browser clients; same-origin needs no entry.
#CAWL_CSRF_TRUSTED_ORIGINS=https://console.example.com
CAWL_HSTS_SECONDS=31536000
CAWL_HSTS_INCLUDE_SUBDOMAINS=1
CAWL_API_PORT=8000

# A wildcard DNS record (*.sbx.example.com) must point to this host.
CAWL_BASE_DOMAIN=sbx.example.com
# Default is auth.<CAWL_BASE_DOMAIN>; set only to override it.
#CAWL_AUTH_HOST=auth.sbx.example.com
#CAWL_WEB_SESSION_TTL=43200
#CAWL_MAGIC_TTL=14400
#CAWL_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#CAWL_EMAIL_FROM=cawl@example.com
# EMAIL_HOST=... EMAIL_PORT=... (standard Django SMTP settings if needed)
TRAEFIK_ACME_EMAIL=ops@example.com
# Traefik/lego DNS challenge provider name; cloudflare is one example.
TRAEFIK_DNS_PROVIDER=cloudflare
# Provider credentials are passed through to Traefik. For Cloudflare:
CF_DNS_API_TOKEN=replace-with-a-cloudflare-dns-api-token

# Incus is normally reachable from the Docker host. Use host.docker.internal on
# Docker Desktop; on Linux use the host gateway address or a routable address.
CAWL_RUNTIME=incus_api
# Default is container; set vm when your templates use VM base images.
#CAWL_DEFAULT_BACKEND=vm
CAWL_INCUS_URL=https://host.docker.internal:8443
CAWL_INCUS_CLIENT_CERT=/run/secrets/incus/client.crt
CAWL_INCUS_CLIENT_KEY=/run/secrets/incus/client.key
CAWL_INCUS_SERVER_CERT=/run/secrets/incus/server.crt
CAWL_INCUS_PROJECT=default
CAWL_IMAGE_PREFIX=cawl
# Add operator-installed Runtime subclasses; see docs/extending.md.
#CAWL_EXTRA_BACKENDS=firecracker=my_backends.FirecrackerRuntime

# SSH access: tailscale | jump | bridge. Leave unset to infer from the settings
# below (authkey → tailscale, jump host → jump, otherwise bridge).
#CAWL_ACCESS=tailscale
# Tailscale is transport only, not Tailscale SSH.
#CAWL_TAILSCALE_AUTHKEY=tskey-auth-xxxx
#CAWL_TAILSCALE_TAGS=tag:cawl
#CAWL_TAILNET=tailXXXX.ts.net
#CAWL_SSH_JUMP=cawl.example.com
# Required for `cawl ssh`; leave unset only if SSH access is intentionally off.
CAWL_SSH_CA_KEY=/run/secrets/ssh_ca
CAWL_SSH_USER=dev
CAWL_SSH_CERT_TTL=10m

# Outbound workload connectivity. This configures workloads but does not enforce
# egress; pair it with an Incus network ACL/firewall.
#CAWL_EGRESS=proxy
#CAWL_EGRESS_NETWORK=cawl-agent
#CAWL_EGRESS_PROXY_URL=http://10.42.0.1:3128
#CAWL_EGRESS_ALLOWED_HOSTS=example.com,github.com
#CAWL_EGRESS_POLICY_NAME=agent-default
#CAWL_EGRESS_POLICY_STORE=/var/lib/cawl/egress-policies.json

CAWL_DEFAULT_QUOTA=10

# Human SSO (optional). Enable + fill OIDC_* to allow browser/admin login.
CAWL_OIDC_ENABLED=0
#OIDC_RP_CLIENT_ID=
#OIDC_RP_CLIENT_SECRET=
#OIDC_OP_AUTH=
#OIDC_OP_TOKEN=
#OIDC_OP_USER=
