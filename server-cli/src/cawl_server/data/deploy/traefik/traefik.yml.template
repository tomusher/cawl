# Cawl writes one route per exposure into the file-provider directory.
# The provisioning role renders these values from cawl-provision.yml.
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: le
        domains:
          - main: "{{ cawl_env.CAWL_API_DOMAIN }}"
          - main: "{{ cawl_env.CAWL_PUBLIC_DOMAIN }}"
            sans:
              - "*.{{ cawl_env.CAWL_PUBLIC_DOMAIN }}"

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

certificatesResolvers:
  le:
    acme:
      email: "{{ cawl_env.TRAEFIK_ACME_EMAIL }}"
      storage: /acme/acme.json
      dnsChallenge:
        provider: "{{ cawl_env.TRAEFIK_DNS_PROVIDER }}"

log:
  level: INFO
accessLog: {}
api:
  dashboard: false
